{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarkov Questing Companion",
  "version": "1.0.1",
  "identifier": "com.diego.tarkovquesting",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "title": "Tarkov Questing Companion",
        "width": 380,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": false,
        "skipTaskbar": false
      },
      {
        "label": "main",
        "title": "Tarkov Questing Companion",
        "width": 1100,
        "height": 720,
        "visible": false
      },
      {
        "label": "minimap",
        "title": "Minimap",
        "width": 320,
        "height": 320,
        "minWidth": 180,
        "minHeight": 180,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
